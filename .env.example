# BCRP MCP Server Configuration
# No API key required — BCRPData is a public API

# Response cache duration in seconds (0 = disabled)
BCRP_CACHE_TTL=300

# HTTP request timeout in seconds
BCRP_TIMEOUT=30

# Maximum retries on transient errors (not on 404)
BCRP_MAX_RETRIES=3

# Default language for series names: "esp" (Spanish) or "ing" (English)
BCRP_LANGUAGE=esp

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
